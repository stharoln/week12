%% 문제 4
clear; clc;

varNames = {'Class','Alcohol','MalicAcid','Ash','Alcalinity','Magnesium',...
            'Phenols','Flavanoids','Nonflavanoid','Proanthocyanins',...
            'ColorIntensity','Hue','OD280','Proline'};

Wine = readtable('wine.data', 'FileType','text', 'Delimiter',',');
