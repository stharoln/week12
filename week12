%% 문제 12
clear; clc;

rng(0);

t = (1:120)';

signal = 30 + 4*sin(t/8) + randn(120,1);

signal(15) = NaN;
signal(45) = NaN;
signal(90) = NaN;

signal(30)  = 80;
signal(75)  = -20;
signal(110) = 95;

idxMissing = isnan(signal);
numMissing = sum(idxMissing);

signalFilled = signal;
signalFilled(idxMissing) = mean(signal, 'omitnan');

mu_f  = mean(signalFilled);
sig_f = std(signalFilled);
idxOutlier = abs(signalFilled - mu_f) > 3 * sig_f;

signalClean = signalFilled;
signalClean(idxOutlier) = NaN;

validSignal = signalClean(~isnan(signalClean));

normSignal = (validSignal - min(validSignal)) ./ (max(validSignal) - min(validSignal));

finalMean = mean(normSignal);
finalVar  = var(normSignal);

figure;
tl = tiledlayout(2,1);
nexttile;
plot(validSignal); xlabel('Index'); ylabel('Value'); title('Valid Signal'); grid on;
nexttile;
plot(normSignal); xlabel('Index'); ylabel('Normalized'); title('Normalized Signal'); grid on;
saveas(gcf, 'result_12.png');

%% 문제 13
clear; clc;

x = -5:0.05:5;
y = -5:0.05:5;
[X, Y] = meshgrid(x, y);

Z = exp(-0.08*(X.^2 + Y.^2)) .* sin(3*X) .* cos(2*Y) + 0.15*sin(X.*Y);

figure;
s1 = surf(X, Y, Z);
shading interp;
colorbar;
xlabel('x-axis', 'FontSize', 12);
ylabel('y-axis', 'FontSize', 12);
zlabel('z=f(x,y)', 'FontSize', 12);
title('Detailed Surface Plot of a Multivariable Function', 'FontSize', 13);
grid on;
ax = gca;
ax.FontSize = 12;
view(45, 30);
hold on;

s2 = surf(X, Y, zeros(size(Z)), 'FaceAlpha', 0.3, 'EdgeColor', 'none', 'FaceColor', [0.5 0.5 0.5]);

maxZ = max(Z(:));
minZ = min(Z(:));

[row_max, col_max] = find(Z == maxZ, 1);
maxPoint = [X(row_max, col_max), Y(row_max, col_max), maxZ];

[row_min, col_min] = find(Z == minZ, 1);
minPoint = [X(row_min, col_min), Y(row_min, col_min), minZ];

p3 = plot3(maxPoint(1), maxPoint(2), maxPoint(3), 'r*', 'MarkerSize', 12, 'LineWidth', 2);
p4 = plot3(minPoint(1), minPoint(2), minPoint(3), 'b^', 'MarkerSize', 12, 'LineWidth', 2);

legend([s1, s2, p3, p4], 'Surface', 'z=0 plane', 'Maximum point', 'Minimum point');

print('complex_surface', '-dpng', '-r150');

