%% 문제 1
clear; clc;

x = [21, 22, NaN, 23, 24, 120, 25, NaN, 26, 27];

idx_missing = isnan(x);

mu0 = mean(x, 'omitnan');
sig0 = std(x, 0, 'omitnan');

idx_outlier = abs(x - mu0) > 3 * sig0;

x_temp = x;
x_temp(idx_missing | idx_outlier) = NaN;

x_clean = x_temp;
x_clean(isnan(x_clean)) = mean(x_temp, 'omitnan');

mu_clean = mean(x_clean);
sig_clean = std(x_clean);

figure;
plot(x, '-o', 'DisplayName', 'Original');
hold on;
plot(x_clean, '--s', 'DisplayName', 'Cleaned');
legend;
xlabel('Index');
ylabel('Value');
title('Original vs Cleaned Data');
grid on;
saveas(gcf, 'result_1.png');

